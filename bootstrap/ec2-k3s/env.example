# Copy this file to .env in the same folder and fill the secret values before running.

# EC2 / networking
PUBLIC_IP=15.134.55.225
APP_HOST=api.15.134.55.225.nip.io
ARGOCD_HOST=argocd.15.134.55.225.nip.io
DASHBOARD_HOST=dashboard.15.134.55.225.nip.io

# GitOps repository
INFRA_REPO_URL=https://github.com/ForeverMoment-Corp/moment-forever-infra.git
INFRA_REPO_BRANCH=main

# GitHub credentials
# Use a PAT that can read/write the infra repository.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=replace-with-github-pat

# Docker Hub credentials
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=replace-with-dockerhub-token

# Let's Encrypt (real HTTPS certs for Argo CD / Dashboard / app ingress)
# Must be a real email address; Let's Encrypt uses it only for expiry/renewal notices.
LETSENCRYPT_EMAIL=you@example.com

# Install channels / manifests
K3S_CHANNEL=stable
INGRESS_NGINX_MANIFEST_URL=https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.12.3/deploy/static/provider/cloud/deploy.yaml
ARGOCD_INSTALL_URL=https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml
ARGOCD_IMAGE_UPDATER_INSTALL_URL=https://raw.githubusercontent.com/argoproj-labs/argocd-image-updater/stable/config/install.yaml
CERT_MANAGER_INSTALL_URL=https://github.com/cert-manager/cert-manager/releases/download/v1.21.2/cert-manager.yaml
